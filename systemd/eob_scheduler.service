[Unit]
Description=BT725 low-tariff water heater scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit these two paths for your setup:
User=user
Group=group
WorkingDirectory=/home/user/eob_scheduler
ExecStart=/usr/bin/python3 /home/user/eob_scheduler/eob_scheduler.py --config /home/user/eob_scheduler/config.yaml
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target

# Install with:
#   sudo cp eob_scheduler.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eob_scheduler
#   sudo journalctl -u eob_scheduler -f     # to watch logs
