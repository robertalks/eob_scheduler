[Unit]
Description=BT725 low-tariff water heater scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit these two paths for your setup:
WorkingDirectory=/home/pi/bt725-tariff-control
ExecStart=/usr/bin/python3 /home/pi/bt725-tariff-control/eob_scheduler.py --config /home/pi/bt725-tariff-control/config.yaml
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target

# Install with:
#   sudo cp bt725-scheduler.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bt725-scheduler
#   sudo journalctl -u bt725-scheduler -f     # to watch logs
